#include <unistd.h>
#include <stdio.h>

int ft_isalnum(int c)
{
    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))
        return (1);
    else
        return (0);
}

int main(void)
{
    printf("%d\n", ft_isalnum('a'));
    printf("%d\n", ft_isalnum('5'));
    printf("%d\n", ft_isalnum('!'));
    return (0);
}